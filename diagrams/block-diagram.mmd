flowchart TB
  student["Student browser"]
  instructor["Instructor browser"]

  subgraph platform["Training platform, one Next.js app"]
    app["Web app and API<br/>auth, hints, flag check,<br/>scoring, points"]
    dash["Instructor dashboard<br/>progress, at-risk learners"]
  end

  subgraph zone["Separate lab network"]
    lab["Vulnerable web app<br/>IDOR, SQL injection, XSS<br/>a flag for each learner"]
  end

  clerk["Clerk<br/>identity"]
  db[("PostgreSQL<br/>attempts, telemetry,<br/>predictions")]
  ml["Analytics and ML worker<br/>at-risk, next challenge"]

  student -- "exploit" --> lab
  student -- "submit flag" --> app
  instructor -- "view" --> dash
  app -- "provision" --> lab
  app -. "sign-in" .-> clerk
  app -- "attempt record" --> db
  dash -- "read progress" --> db
  db <-. "attempts out,<br/>predictions in" .-> ml

  classDef planned stroke:#8C8C8C,stroke-dasharray:3 3,color:#595959;
  classDef partial stroke-dasharray:6 4;
  classDef danger stroke:#B8473F,stroke-width:1.5px;
  class ml planned;
  class dash partial;
  class lab danger;
  style platform fill:#FDF4EA,stroke:#E2B181;
  style zone fill:#FBEEEC,stroke:#B8473F,stroke-dasharray:5 4;
